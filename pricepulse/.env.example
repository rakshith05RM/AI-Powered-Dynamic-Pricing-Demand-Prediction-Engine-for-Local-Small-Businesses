# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database engine: mysql or sqlite
# Use sqlite for a zero-config quick start, mysql for the intended production setup.
DB_ENGINE=mysql

# MySQL settings (used when DB_ENGINE=mysql)
MYSQL_DATABASE=pricepulse
MYSQL_USER=pricepulse_user
MYSQL_PASSWORD=change-this-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
